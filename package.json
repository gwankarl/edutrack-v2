{
  "name": "edutrack",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "contracts"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workspaces": "npm ls --workspaces --depth=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
