{
  "name": "@edutrack/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "test": "vitest run src --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:check": "tsx --env-file=.env src/infrastructure/database/check-connection.ts",
    "email:mailtrap:verify": "tsx --env-file=.env src/infrastructure/email/check-mailtrap.ts verify",
    "email:mailtrap:send-test": "tsx --env-file=.env src/infrastructure/email/check-mailtrap.ts send-test"
  },
  "dependencies": {
    "@edutrack/contracts": "^0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
