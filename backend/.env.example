NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/edutrack_dev
DATABASE_TEST_URL=postgresql://edutrack_test:PASSWORD@localhost:5432/edutrack_test
HOST=127.0.0.1

# Local Mailtrap Email Sandbox. Put real credentials only in the ignored backend/.env.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_MAILTRAP_SANDBOX_USERNAME
SMTP_PASSWORD=REPLACE_WITH_MAILTRAP_SANDBOX_PASSWORD
SMTP_FROM_EMAIL=edutrack@example.test
SMTP_FROM_NAME=EduTrack
